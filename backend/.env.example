# Chat model: Ollama API (the provider appends /chat to the base URL)
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_MODEL=gemma4:31b
# Sent as a Bearer token. Create one at https://ollama.com/settings/keys (see Setup in README.md)
OLLAMA_API_KEY=your-ollama-api-key
# Optional context window in tokens; Ollama silently truncates longer prompts
# OLLAMA_NUM_CTX=32768

# Embeddings: Ollama's cloud API cannot embed, so these use a local Ollama
# (the ollama service in docker-compose.yml). Docker Compose overrides the URL
# to reach that container; these defaults are for running the backend directly.
# OLLAMA_EMBED_BASE_URL=http://localhost:11434/api
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_EMBED_API_KEY=

# SQLite database file (Docker Compose stores it in a volume)
# DATABASE_URL=local.db
# PORT=3000
